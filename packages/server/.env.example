# Copy to .env for local development. Never commit the real .env file (it's gitignored).

# Port the server listens on. Railway sets this automatically in production — don't set it there.
PORT=3001

# Comma-separated list of allowed client origins (CORS + Socket.IO). A literal "*" allows any
# origin — only for local testing against a throwaway tunnel URL; never use in a real deployment.
CLIENT_ORIGIN=http://localhost:5173

# Set to "true" to have this server also serve the built client (packages/client/dist) from the
# same port, so testing over a single tunnel (e.g. a free ngrok account's one-tunnel limit) only
# needs to expose one port instead of keeping client and server tunnels in sync. Leave unset
# normally — client and server are genuinely separate services in production.
SERVE_CLIENT_DIST=

# Upstash Redis (REST API) — from the database's dashboard at upstash.com, under "REST API".
# Without these, the server still runs fine; push subscriptions just aren't persisted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# VAPID keypair for Web Push — generate once with `node -e "console.log(require('web-push').generateVAPIDKeys())"`
# and never regenerate afterward (that would invalidate every existing subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact info included in push requests per the Web Push spec — a mailto: or an https: URL.
VAPID_SUBJECT=
